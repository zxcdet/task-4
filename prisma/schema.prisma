generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id       BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  name     String? @db.VarChar(50)
  login    String? @db.VarChar(50)
  password String  @db.VarChar(256)
  Task     Task[]

  @@map("users")
}

model Board {
  id      BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  title   String @db.VarChar(50)
  columns Json
  Task    Task[]

  @@map("boards")
}

model Task {
  id          BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  title       String  @db.VarChar(50)
  order       Int
  description String  @db.VarChar(50)
  userId      BigInt? @db.UnsignedBigInt
  boardId     BigInt  @db.UnsignedBigInt
  columnId    BigInt? @db.UnsignedBigInt
  user        User?   @relation(fields: [userId], references: [id],  onDelete: SetNull, onUpdate: NoAction, map: "tasks_ibfk_1")
  board       Board   @relation(fields: [boardId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tasks_ibfk_2")

  @@index([boardId], map: "boardId")
  @@index([userId], map: "userId")
  @@map("tasks")
}
